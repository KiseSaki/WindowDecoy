<Window x:Class="WindowDecoy.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择目标窗口 / 进程"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F8F8" />
                    <Setter Property="BorderBrush" Value="#0067C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search and Refresh Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="34"
                     Padding="8,6"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     BorderBrush="#D1D5DB"
                     BorderThickness="1"
                     TextChanged="SearchTextBox_TextChanged" />

            <TextBlock IsHitTestVisible="False"
                       Text="🔍 搜索进程名或窗口标题..."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"
                       Foreground="#9CA3AF"
                       FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1"
                    Content="🔄 刷新列表"
                    Margin="8,0,0,0"
                    Height="34"
                    Click="RefreshButton_Click" />
        </Grid>

        <!-- Windows List Container -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Body -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="程序名称 (PID)" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="窗口标题" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="句柄 HWND" FontWeight="SemiBold" Foreground="#4B5563" FontSize="12" />
                    </Grid>
                </Border>

                <!-- Table Content ListBox (No GridViewColumnHeader cursor bug) -->
                <ListBox Grid.Row="1"
                         x:Name="WindowsListBox"
                         BorderThickness="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="WindowsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="12,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#EFF6FF" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#F3F4F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- Process Name & PID -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="#111827" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Foreground="#6B7280" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Run Text="(PID: " /><Run Text="{Binding ProcessId}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Window Title -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="#374151"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="4,0,12,0" />

                                <!-- HWND -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Hwnd}"
                                           FontSize="12"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确认绑定目标"
                    Background="#0067C0"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="34"
                    FontWeight="SemiBold"
                    Padding="20,6"
                    Margin="0,0,10,0"
                    Click="SelectButton_Click" />
            <Button Content="取消"
                    Height="34"
                    Padding="16,6"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
